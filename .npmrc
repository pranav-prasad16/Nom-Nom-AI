# Allow native build scripts for known dependencies.
# Required by pnpm v9+ which blocks postinstall/build lifecycle scripts by default.
# These packages need to compile native binaries or generate client code at install time.
#
# Packages approved:
#   @prisma/client, @prisma/engines, prisma  — generate the Prisma query engine binary
#   bcrypt                                   — compiles a native C++ bcrypt addon
#   esbuild                                  — downloads the platform-correct esbuild binary

onlyBuiltDependencies=@prisma/client,@prisma/engines,prisma,bcrypt,esbuild
